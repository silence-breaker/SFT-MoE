# ============================================================================
# Qwen3-30B-A3B SFT 训练镜像 (LLaMA-Factory + 8x A100 40GB)
# ============================================================================

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

# 避免交互式安装阻塞构建
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# ============================================================================
# 1. 系统基础依赖
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    python3-pip \
    git \
    curl \
    wget \
    vim \
    htop \
    tmux \
    ninja-build \
    pkg-config \
    libc6-dev \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && python3 -m pip install --upgrade pip setuptools wheel packaging \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# 2. PyTorch (CUDA 12.4)
# ============================================================================
RUN pip install torch==2.4.0 torchvision==0.19.0 --index-url https://download.pytorch.org/whl/cu124

# ============================================================================
# 3. FlashAttention-2 (A100 核心加速组件)
# ============================================================================
ENV TORCH_CUDA_ARCH_LIST="8.0"
ENV MAX_JOBS=4
RUN pip install flash-attn==2.6.3 --no-build-isolation --no-cache-dir

# ============================================================================
# 4. LLaMA-Factory + DeepSpeed
# ============================================================================
RUN pip install --no-cache-dir \
    "llamafactory[metrics,bitsandbytes]" \
    "deepspeed>=0.16.2,<=0.16.9" \
    "accelerate>=1.1.0" \
    "peft>=0.13.0" \
    "transformers==4.51.0" \
    "liger-kernel"
# ============================================================================
# 5. 环境配置与验证
# ============================================================================
ENV PATH="/root/.local/bin:/usr/local/bin:${PATH}"
WORKDIR /app

# 验证关键组件
RUN python3 -c "import torch; print(f'Torch: {torch.__version__}, CUDA: {torch.version.cuda}')" \
    && python3 -c "import flash_attn; print(f'FlashAttn: {flash_attn.__version__}')" \
    && python3 -c "import llamafactory; print('LLaMA-Factory OK')" \
    && deepspeed --version || true

ENTRYPOINT []
CMD ["/bin/bash"]